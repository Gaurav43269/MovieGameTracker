rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 60));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'preferredRegion',
          'favoriteGenres',
          'favoritePlatforms',
          'bio',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'preferredRegion',
          'favoriteGenres',
          'favoritePlatforms',
          'bio',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredRegion in ['All', 'Nepali', 'Hollywood', 'Bollywood', 'Asian', 'European', 'Global']
        && isValidStringArray(data.favoriteGenres, 8)
        && isValidStringArray(data.favoritePlatforms, 8)
        && data.bio is string && data.bio.size() <= 280
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedMediaItem(data, userId, itemId) {
      return data.keys().hasAll([
          'id',
          'uid',
          'title',
          'mediaType',
          'region',
          'language',
          'releaseDate',
          'displayDate',
          'status',
          'genres',
          'platforms',
          'popularityScore',
          'creator',
          'castOrStudio',
          'runtimeOrPlaytime',
          'synopsis',
          'releaseNotes',
          'inWatchlist',
          'isFavorite',
          'userNotes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'title',
          'originalTitle',
          'mediaType',
          'region',
          'language',
          'releaseDate',
          'displayDate',
          'releaseYear',
          'status',
          'genres',
          'platforms',
          'rating',
          'popularityScore',
          'creator',
          'castOrStudio',
          'runtimeOrPlaytime',
          'synopsis',
          'releaseNotes',
          'inWatchlist',
          'isFavorite',
          'userNotes',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 200))
        && data.mediaType in ['movie', 'game']
        && data.region in ['Nepali', 'Hollywood', 'Bollywood', 'Asian', 'European', 'Global']
        && data.language is string && data.language.size() >= 1 && data.language.size() <= 60
        && data.releaseDate is string && data.releaseDate.size() >= 1 && data.releaseDate.size() <= 32
        && data.displayDate is string && data.displayDate.size() >= 1 && data.displayDate.size() <= 80
        && (!('releaseYear' in data) || (data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100))
        && data.status in ['Upcoming', 'Released', 'TBA']
        && isValidStringArray(data.genres, 5)
        && isValidStringArray(data.platforms, 6)
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 10))
        && data.popularityScore is int && data.popularityScore >= 1 && data.popularityScore <= 100
        && data.creator is string && data.creator.size() >= 1 && data.creator.size() <= 140
        && isValidStringArray(data.castOrStudio, 5)
        && data.runtimeOrPlaytime is string && data.runtimeOrPlaytime.size() >= 1 && data.runtimeOrPlaytime.size() <= 60
        && data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 800
        && data.releaseNotes is string && data.releaseNotes.size() <= 400
        && data.inWatchlist is bool
        && data.isFavorite is bool
        && data.userNotes is string && data.userNotes.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredRegion',
          'favoriteGenres',
          'favoritePlatforms',
          'bio',
          'updatedAt'
        ]);
      allow delete: if false;

      match /savedItems/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(itemId)
          && isVerified()
          && isOwner(userId)
          && isValidSavedMediaItem(incoming(), userId, itemId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(itemId)
          && isVerified()
          && isOwner(userId)
          && isValidSavedMediaItem(incoming(), userId, itemId)
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'inWatchlist',
            'isFavorite',
            'userNotes',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(itemId) && isVerified() && isOwner(userId);
      }
    }
  }
}
